#include <stdio.h>
#include <string.h>

enum kind { TEMPERATURE, HUMIDITY, STATUS };

struct reading {
    enum kind type; /* tag: tells which union member is valid */
    union {
        float celsius;
        int percent;
        char status[8];
    } value;
};

/* Structure-only design for Task 3.1/3.2 size comparison */
struct reading_all_fields {
    enum kind type;
    float celsius;
    int percent;
    char status[8];
};

void show(const struct reading *r)
{
    /* TODO 1: Use a switch on r->type to print only the valid union member:
       "Temp 31.5 C", "Humidity 68%" or "Status OK" */
    switch (r->type) {
        case TEMPERATURE:
            printf("Temp %.1f C\n", r->value.celsius);
            break;
        case HUMIDITY:
            printf("Humidity %d%%\n", r->value.percent);
            break;
        case STATUS:
            printf("Status %s\n", r->value.status);
            break;
        default:
            printf("Unknown reading type\n");
            break;
    }
}

int main(void)
{
    struct reading log[3] = {
        {TEMPERATURE, {.celsius = 31.5f}},
        {HUMIDITY,    {.percent = 68}},
        {STATUS,      {.status = "OK"}}
    };

    printf("sizeof union = %zu, sizeof struct reading = %zu\n",
           sizeof log[0].value, sizeof log[0]);
    printf("sizeof struct reading_all_fields = %zu\n",
           sizeof(struct reading_all_fields));

    for (int i = 0; i < 3; i++) {
        show(&log[i]);
    }

    /* Task 3.4: Misuse experiment - store float, read int member */
    struct reading bad;
    bad.type = TEMPERATURE;
    bad.value.celsius = 31.5f;
    printf("\nMisuse read (celsius=31.5f interpreted as int percent): %d\n",
           bad.value.percent);

    return 0;
}
